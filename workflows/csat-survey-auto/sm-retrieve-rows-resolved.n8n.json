        "jsonBody": "=[\n  {\n  \"id\":  \"{{ $json.id }}\",\n  \"userName\": \"{{ $json.userName }}\",\n  \"userId\": \"{{ $json.userId }}\",\n  \"userEmail\": \"{{ $json.userEmail }}\",\n  \"tech\": \"{{ $json.tech }}\",\n  \"techID\": \"{{ $json.techID }}\",\n  \"techEmail\": \"{{ $json.techEmail }}\",\n  \"date\": \"{{ $json.date }}\",\n  \"status\": \"{{ $json.status }}\"\n  }\n]",
