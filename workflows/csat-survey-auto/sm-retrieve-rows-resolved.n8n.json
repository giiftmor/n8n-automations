      "id": "dd3198ef-5cf5-4cae-b77b-a3845b4f30b7",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "USE CiresonAnalytics;\n-- Active Service Requests that are Completed yesterday for specified Tiers\nSELECT \n    WorkItemId,\n    Title,\n    CreatedByUser,\n    Category,\n    Tier,\n    Description,\n    AffectedUser,\n    AssignedUser,\n    Status,\n    Created,\n    CompletedDate,\n    LastModified,\n    ClosedDate\nFROM dbo.SM_WorkItem_ServiceRequest\nWHERE Status = 'Completed'\n  AND CAST(CompletedDate AS DATE) = CAST(DATEADD(DAY, -1, GETDATE()) AS DATE)\n  AND Tier IN ('Potch Staff Service Desk', 'Potch Student Service Desk');\n\n-- Active Incidents that are Resolved yesterday for specified Tiers\nSELECT \n    WorkItemId,\n    Title,\n    CreatedByUser,\n    Category,\n    Tier,\n    Description,\n    AssignedUser,\n    AffectedUser,\n    Status,\n    Created,\n    ResolvedDate,\n    LastModified,\n    ClosedDate\nFROM dbo.SM_WorkItem_Incident\nWHERE Status = 'Resolved'\n  AND CAST(ResolvedDate AS DATE) = CAST(DATEADD(DAY, -1, GETDATE()) AS DATE)\n  AND Tier IN ('Potch Staff Service Desk', 'Potch Student Service Desk');",
        "options": {}
      },
      "type": "n8n-nodes-base.microsoftSql",
      "typeVersion": 1.1,
      "position": [80, -384],
      "id": "330bd3e0-8366-40b8-8430-833eaba87317",
      "name": "Get Tickets Done Today",
      "credentials": {
        "microsoftSql": {
          "id": "FHbJvXzEv35eLNHI",
          "name": "Service Manager"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => ({\n  json: {\n    id: item.json.WorkItemId,\n    user: item.json.AffectedUser,\n    tech: item.json.AssignedUser,\n    dateDone: item.json.CompletedDate || item.json.ResolvedDate,\n    status: item.json.Status\n  }\n}))"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [304, -384],
      "id": "126df379-48d6-4c1a-b564-8c8ee5c5764e",
      "name": "Clean Ticket Data"
    },
    {
      "parameters": {
        "jsCode": "const ticketData = $(\"Clean Ticket Data\").all();\nconst endUserInfo = $(\"Clean End_User Info\").all();\nconst analystInfo = $(\"Clean Analyst/Tech Info\").all();\n\nconst response = ticketData.map(ticket => {\n  const userDetails = endUserInfo.find(u => {\n    return u.json.user && ticket.json.user && u.json.user.trim() === ticket.json.user.trim();\n  });\n  const techDetails = analystInfo.find(t => {\n    return t.json.tech && ticket.json.tech && t.json.tech.trim() === ticket.json.tech.trim();\n  });\n\n  return {\n    json: {\n      id: ticket.json.id,\n      userName: ticket.json.user,\n      userId: userDetails ? userDetails.json.userID : null,\n      userEmail: userDetails ? userDetails.json.userEmail : null,\n      tech: ticket.json.tech,\n      techID: techDetails ? techDetails.json.techID : null,\n      techEmail: techDetails ? techDetails.json.techEmail : null,\n      date: ticket.json.dateDone,\n      status: ticket.json.status\n    }\n  };\n});\n\nreturn response;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
